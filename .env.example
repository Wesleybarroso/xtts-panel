# EasyPanel / produção
NODE_ENV=production
PORT=3000

# Banco e autenticação
DATABASE_URL=mysql://usuario:senha@host:3306/xtts_panel
JWT_SECRET=gere-um-segredo-longo-e-unico

# Servidor XTTS remoto
XTTS_SERVER_URL=http://seu-servidor-xtts:8000
XTTS_API_KEY=cole_a_chave_secreta_do_servidor_xtts_aqui

# Dependências opcionais/recomendadas
REDIS_URL=redis://host:6379
CORS_ORIGINS=https://seu-dominio.example.com

# OAuth/storage, se usados pelo ambiente
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
WEBHOOK_SECRET=
VITE_APP_ID=
